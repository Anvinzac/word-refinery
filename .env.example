# Word Refinery build configuration.
#
# NOTHING HERE IS A SECRET. API keys are entered in the app's Settings panel and
# stored in the browser's localStorage - they are never read from this file and
# must never be committed.
#
# Base path the bundle is served from. GitHub Pages hosts the app under a
# subpath named after the repository, so the default matches that. Set it to "/"
# for local development or a custom domain.
VITE_BASE_PATH=/word-refinery/
